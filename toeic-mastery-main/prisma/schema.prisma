// TOEIC Mastery — Prisma schema
// Self-hosted Postgres. Auth is hand-rolled Google OAuth (see
// src/lib/auth/google.ts) — Profile.id is generated by the app itself, not
// mirrored from any external auth provider.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum PlanTier {
  FREE
  PRO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AttributionSource {
  COOKIE
  FINGERPRINT
}

enum CommissionStatus {
  PENDING
  WITHDRAWABLE
  PAID
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum DeviceType {
  COMPUTER
  PHONE
  TABLET
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestPart {
  PART1
  PART2
  PART3
  PART4
  PART5
  PART6
  PART7
}

enum Skill {
  LISTENING
  READING
}

enum PassageFormat {
  CONVERSATION
  TALK
  EMAIL
  ADVERTISEMENT
  MEMO
  NOTICE
  ARTICLE
  CHAT
  INVOICE
  SCHEDULE
  FORM
  LETTER
  OTHER
}

enum PassageLayout {
  SINGLE
  DOUBLE
  TRIPLE
}

enum AttemptMode {
  PRACTICE
  EXAM
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum BookmarkType {
  QUESTION
  VOCABULARY
  GRAMMAR
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum StudyActivity {
  EXAM
  PRACTICE
  VOCABULARY
  GRAMMAR
  DICTIONARY
}

enum DictionarySource {
  SEARCH
  SELECTION
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// --- AI Mentor ---------------------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  PLACEMENT_PENDING
  READY
}

enum VocabOrigin {
  MANUAL
  AI_DETECTED_WEAKNESS
}

enum MentorRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MentorConversationStatus {
  ACTIVE
  ARCHIVED
}

enum SkillDimensionType {
  PART
  GRAMMAR_TOPIC
  VOCAB_TOPIC
  /** A composite, all-Parts diagnostic (see generatePlacementTest) rather
   * than one specific skill dimension — dimensionKey is always "ALL". */
  PLACEMENT
}

enum LearningPathStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum LearningDayStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

enum LearningItemType {
  GRAMMAR_LESSON
  VOCAB_TOPIC
  VOCAB_REVIEW
  LISTENING_PRACTICE
  READING_PRACTICE
  MINI_TEST
  FULL_TEST
  TIP
}

enum LearningItemStatus {
  PENDING
  DONE
  SKIPPED
}

enum MentorTestStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

enum EmbeddingSourceType {
  GRAMMAR_LESSON
  VOCABULARY_WORD
  QUESTION_EXPLANATION
  VOCABULARY_TOPIC
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model Profile {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  /**
   * Google account's stable `sub` claim — secondary link kept alongside the
   * email-based lookup used at sign-in (see src/app/auth/callback/route.ts),
   * as insurance if a user's Google account email ever changes.
   */
  googleId                String?   @unique @map("google_id")
  /**
   * scrypt hash of the account's password (see src/lib/auth/password.ts) —
   * null for accounts that have only ever signed in with Google. Email
   * login (src/app/(auth)/actions.ts) rejects with a clear "use Google"
   * error rather than a generic "wrong password" when this is null.
   */
  passwordHash            String?   @map("password_hash")
  /** Hash (not the raw code) of the most recently issued forgot-password
   * OTP, plus its expiry — see requestPasswordResetAction /
   * resetPasswordAction in src/app/(auth)/actions.ts. Both null once
   * unused/consumed/expired. */
  resetCodeHash           String?   @map("reset_code_hash")
  resetCodeExpiresAt      DateTime? @map("reset_code_expires_at")
  fullName                String?   @map("full_name")
  avatarUrl               String?   @map("avatar_url")
  role                    Role      @default(STUDENT)
  plan                    PlanTier  @default(FREE)
  proExpiresAt            DateTime? @map("pro_expires_at")
  currentScore            Int?      @map("current_score")
  targetScore             Int?      @map("target_score")
  examDate                DateTime? @map("exam_date") @db.Date
  /**
   * Drives whether AI Mentor opens with the goal/placement-test onboarding
   * chat or goes straight to today's LearningPathDay — see
   * src/lib/services/mentor/onboarding.ts. NOT_STARTED until the mentor
   * chat has captured a goal; PLACEMENT_PENDING once a goal is known but no
   * score baseline exists yet; READY once a LearningPath can be generated.
   */
  onboardingStatus        OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingCompletedAt   DateTime? @map("onboarding_completed_at")
  dailyStudyTargetMinutes Int       @default(30) @map("daily_study_target_minutes")
  streakCount             Int       @default(0) @map("streak_count")
  longestStreak           Int       @default(0) @map("longest_streak")
  lastStudyDate           DateTime? @map("last_study_date") @db.Date
  /**
   * Cumulative XP spent in the XP shop — never applied to the lifetime XP
   * total itself (see src/lib/services/xp.ts's computeXp), just subtracted
   * from it when computing spendable balance, so redeeming an item can
   * never lower the account's rank/level.
   */
  xpSpent                 Int       @default(0) @map("xp_spent")
  /**
   * Id of the XP_SHOP_ITEMS entry (src/lib/constants/xp-shop.ts) currently
   * shown as this account's avatar frame in the header/sidebar — null means
   * the plain avatarUrl photo (or its fallback initial) with no frame.
   * Deliberately not a foreign key: shop items are a static catalog, not a
   * DB table, same as UserShopItem.itemId.
   */
  equippedShopItemId      String?   @map("equipped_shop_item_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  referralCode            String?            @unique @map("referral_code")
  referredByProfileId     String?            @map("referred_by_profile_id") @db.Uuid
  referredAt              DateTime?          @map("referred_at")
  attributionSource       AttributionSource? @map("attribution_source")
  isLateAttribution       Boolean            @default(false) @map("is_late_attribution")
  firstProPaymentAt       DateTime?          @map("first_pro_payment_at")
  successfulReferralCount Int                @default(0) @map("successful_referral_count")
  isFlaggedFraud          Boolean            @default(false) @map("is_flagged_fraud")
  fraudNote               String?            @map("fraud_note")

  settings          UserSettings?
  attempts          Attempt[]
  bookmarks         Bookmark[]
  userVocabulary    UserVocabulary[]
  studySessions     StudySession[]
  scoreHistory      ScoreHistory[]
  dictionaryHistory DictionaryHistory[]
  answerRevealLogs  AnswerRevealLog[]
  savedWords        SavedWord[]
  questionReports   QuestionReport[]
  createdTests      Test[]                          @relation("TestAuthor")
  pathDayProgress   UserVocabularyPathDayProgress[]
  payments          Payment[]
  redeemedCodes     ActivationCode[]
  shopItems         UserShopItem[]
  mentorConversations MentorConversation[]
  mentorMemory      MentorMemory?
  skillMastery      SkillMastery[]
  skillUnlocks      SkillUnlock[]
  learningPaths     LearningPath[]
  mentorTests       MentorTest[]

  referredBy        Profile?           @relation("Referrals", fields: [referredByProfileId], references: [id], onDelete: SetNull)
  referrals         Profile[]          @relation("Referrals")
  bankAccount       BankAccount?
  devices           Device[]
  pushSubscriptions PushSubscription[]
  referralClicks    ReferralClick[]
  commissionsEarned Commission[]       @relation("CommissionsEarned")
  commissionsFromMe Commission[]       @relation("CommissionsFromReferral")
  withdrawals       Withdrawal[]

  @@map("profiles")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  orderId          String        @unique @map("order_id")
  amount           Int
  planDurationDays Int           @map("plan_duration_days")
  status           PaymentStatus @default(PENDING)
  vnpTransactionNo String?       @map("vnp_transaction_no")
  createdAt        DateTime      @default(now()) @map("created_at")
  paidAt           DateTime?     @map("paid_at")
  refundedAt       DateTime?     @map("refunded_at")

  user       Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commission Commission?

  @@index([userId])
  @@map("payments")
}

/**
 * Admin-generated single-use codes that grant Pro directly, as an
 * alternative to the bank-transfer + manual-approval flow (e.g. for
 * giveaways, partners, or a learner who paid through some other channel).
 */
model ActivationCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  planDurationDays Int       @map("plan_duration_days")
  usedByUserId     String?   @map("used_by_user_id") @db.Uuid
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  usedBy Profile? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@map("activation_codes")
}

model UserSettings {
  id                     String          @id @default(uuid()) @db.Uuid
  userId                 String          @unique @map("user_id") @db.Uuid
  theme                  ThemePreference @default(LIGHT)
  /**
   * Selected site-wide "Live theme" wallpaper (see SITE_THEMES registry in
   * src/lib/constants/site-themes.ts). Plain string, not an enum, so new
   * themes can ship without a migration.
   */
  siteTheme              String          @default("lily-pond-cat") @map("site_theme")
  language               String          @default("vi")
  audioAutoplay          Boolean         @default(true) @map("audio_autoplay")
  defaultPlaybackSpeed   Float           @default(1) @map("default_playback_speed")
  dictionaryPopupEnabled Boolean         @default(true) @map("dictionary_popup_enabled")
  dailyReminderEnabled   Boolean         @default(false) @map("daily_reminder_enabled")
  dailyReminderTime      String?         @map("daily_reminder_time")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// Tests / questions
// ---------------------------------------------------------------------------

model Test {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  title              String
  description        String?
  thumbnailUrl       String?       @map("thumbnail_url")
  difficulty         Difficulty    @default(MEDIUM)
  status             ContentStatus @default(DRAFT)
  isFullTest         Boolean       @default(true) @map("is_full_test")
  isPro              Boolean       @default(false) @map("is_pro")
  durationMinutes    Int           @default(120) @map("duration_minutes")
  totalQuestions     Int           @default(200) @map("total_questions")
  listeningQuestions Int           @default(100) @map("listening_questions")
  readingQuestions   Int           @default(100) @map("reading_questions")
  attemptLimit       Int?          @map("attempt_limit")
  allowReplay        Boolean       @default(true) @map("allow_replay")
  createdById        String?       @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  createdBy Profile?      @relation("TestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sections  TestSection[]
  passages  Passage[]
  questions Question[]
  attempts  Attempt[]

  @@index([status])
  @@index([isFullTest])
  @@index([isPro])
  @@map("tests")
}

model TestSection {
  id            String   @id @default(uuid()) @db.Uuid
  testId        String   @map("test_id") @db.Uuid
  part          TestPart
  title         String
  orderIndex    Int      @map("order_index")
  questionCount Int      @default(0) @map("question_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, part])
  @@map("test_sections")
}

model Passage {
  id         String        @id @default(uuid()) @db.Uuid
  testId     String?       @map("test_id") @db.Uuid
  part       TestPart
  format     PassageFormat @default(OTHER)
  layout     PassageLayout @default(SINGLE)
  title      String?
  texts      Json          @default("[]") // [{ label: string, content: string }]
  audioUrl   String?       @map("audio_url")
  /** Up to 3 images (some Part 6/7 sets reference more than one figure —
   * e.g. a form plus a schedule). `imageUrl` always mirrors `imageUrls[0]`
   * on every write, kept only for the several read-only surfaces (bookmark
   * previews, mistake/quick-study review cards) that only ever show one
   * preview image and have no reason to handle the full array. The admin
   * form and the real exam-taking passage view use `imageUrls`. */
  imageUrl   String?       @map("image_url")
  imageUrls  String[]      @default([]) @map("image_urls")
  transcript String?
  orderIndex Int           @default(0) @map("order_index")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  test      Test?      @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([testId, part])
  @@map("passages")
}

model Question {
  id               String        @id @default(uuid()) @db.Uuid
  testId           String?       @map("test_id") @db.Uuid
  testSectionId    String?       @map("test_section_id") @db.Uuid
  passageId        String?       @map("passage_id") @db.Uuid
  grammarTopicId   String?       @map("grammar_topic_id") @db.Uuid
  part             TestPart
  orderIndex       Int           @default(0) @map("order_index")
  prompt           String
  imageUrl         String?       @map("image_url")
  audioUrl         String?       @map("audio_url")
  transcript       String?
  correctLabel     String        @map("correct_label") @db.VarChar(1)
  explanationVi    String        @map("explanation_vi")
  grammarTopicSlug String?       @map("grammar_topic_slug")
  vocabularyFocus  String[]      @default([]) @map("vocabulary_focus")
  evidenceText     String?       @map("evidence_text")
  difficulty       Difficulty    @default(MEDIUM)
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  test         Test?             @relation(fields: [testId], references: [id], onDelete: Cascade)
  testSection  TestSection?      @relation(fields: [testSectionId], references: [id], onDelete: SetNull)
  passage      Passage?          @relation(fields: [passageId], references: [id], onDelete: SetNull)
  grammarTopic GrammarTopic?     @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  options      QuestionOption[]
  answers      AttemptAnswer[]
  bookmarks    Bookmark[]
  reports      QuestionReport[]
  revealLogs   AnswerRevealLog[]
  mentorConversationOrigins MentorConversation[]
  mentorTestAppearances     MentorTestQuestion[]

  @@index([testId, part, orderIndex])
  @@index([part])
  @@map("questions")
}

model QuestionOption {
  id                    String  @id @default(uuid()) @db.Uuid
  questionId            String  @map("question_id") @db.Uuid
  label                 String  @db.VarChar(1)
  content               String
  isCorrect             Boolean @default(false) @map("is_correct")
  distractorExplanation String? @map("distractor_explanation")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@map("question_options")
}

// ---------------------------------------------------------------------------
// Attempts
// ---------------------------------------------------------------------------

model Attempt {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  testId               String        @map("test_id") @db.Uuid
  mode                 AttemptMode   @default(EXAM)
  status               AttemptStatus @default(IN_PROGRESS)
  /**
   * Which Parts this attempt actually covers — empty means "the whole test"
   * (every existing attempt, and the default "Full Test" choice). Non-empty
   * scopes getExamData's question query and is what "Thi Listening"/"Thi
   * Reading"/"Thi theo Part" (see attempt-start-panel.tsx) actually are:
   * the same test, just a Part subset, rather than a separate Test row per
   * combination. Always stored sorted by TEST_PART_VALUES order so the
   * "resume this exact in-progress attempt" lookup in startAttemptAction
   * can compare it with a plain array `equals`.
   */
  parts                TestPart[]    @default([])
  /**
   * Explicit question ids this attempt covers — used only by a "retry just
   * these questions" attempt (see startMistakeRetryAction: redoing just the
   * ones a previous attempt got wrong/skipped, which no testId+parts
   * combination can express since they can span the whole test, not one
   * contiguous Part range). Empty (the default, and every attempt before
   * this field existed) means "use testId+parts as before" — every question
   * query in getExamData/getAttemptResult/the submit and reveal routes
   * checks this first and only falls back to testId+parts when it's empty.
   */
  questionIds          String[]      @default([]) @map("question_ids")
  currentQuestionIndex Int           @default(0) @map("current_question_index")
  allowedDurationSec   Int           @map("allowed_duration_sec")
  remainingSec         Int           @map("remaining_sec")
  listeningScore       Int?          @map("listening_score")
  readingScore         Int?          @map("reading_score")
  totalScore           Int?          @map("total_score")
  correctCount         Int?          @map("correct_count")
  wrongCount           Int?          @map("wrong_count")
  skippedCount         Int?          @map("skipped_count")
  startedAt            DateTime      @default(now()) @map("started_at")
  lastSyncedAt         DateTime      @default(now()) @map("last_synced_at")
  submittedAt          DateTime?     @map("submitted_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user         Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test         Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      AttemptAnswer[]
  scoreHistory ScoreHistory[]
  studySession StudySession?
  mentorConversationOrigins MentorConversation[]

  @@index([userId, status])
  @@index([testId])
  @@map("attempts")
}

model AttemptAnswer {
  id            String    @id @default(uuid()) @db.Uuid
  attemptId     String    @map("attempt_id") @db.Uuid
  questionId    String    @map("question_id") @db.Uuid
  selectedLabel String?   @map("selected_label") @db.VarChar(1)
  isCorrect     Boolean?  @map("is_correct")
  isFlagged     Boolean   @default(false) @map("is_flagged")
  timeSpentSec  Int       @default(0) @map("time_spent_sec")
  answeredAt    DateTime? @map("answered_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  flaggedVocabulary UserVocabulary[]

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// ---------------------------------------------------------------------------
// Bookmarks / reports
// ---------------------------------------------------------------------------

model Bookmark {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  type             BookmarkType
  questionId       String?      @map("question_id") @db.Uuid
  vocabularyWordId String?      @map("vocabulary_word_id") @db.Uuid
  grammarLessonId  String?      @map("grammar_lesson_id") @db.Uuid
  note             String?
  createdAt        DateTime     @default(now()) @map("created_at")

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question?       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord? @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  grammarLesson  GrammarLesson?  @relation(fields: [grammarLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, type, questionId, vocabularyWordId, grammarLessonId])
  @@map("bookmarks")
}

model QuestionReport {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  reason     String
  message    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("question_reports")
}

// ---------------------------------------------------------------------------
// Vocabulary
// ---------------------------------------------------------------------------

model VocabularyTopic {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  icon        String?
  /**
   * Groups topics into sections on /vocabulary/topics (e.g. "Theo band
   * điểm", "Theo Part", "Cụm từ cố định & thường gặp"). Null for the
   * original context-based topics (office, travel, ...), which render in
   * their own ungrouped section. Mirrors GrammarTopic.category.
   */
  category    String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  words VocabularyWord[]

  @@map("vocabulary_topics")
}

model VocabularyWord {
  id           String     @id @default(uuid()) @db.Uuid
  topicId      String     @map("topic_id") @db.Uuid
  word         String
  ipa          String?
  /**
   * Optional so quick Quizlet-style bulk import (term + meaning only) works
   * without forcing every field up front — an admin can flesh a word out
   * with part of speech/examples later via edit.
   */
  partOfSpeech String?    @map("part_of_speech")
  meaningVi    String     @map("meaning_vi")
  definitionEn String?    @map("definition_en")
  exampleEn    String?    @map("example_en")
  exampleVi    String?    @map("example_vi")
  synonyms     String[]   @default([])
  antonyms     String[]   @default([])
  collocations String[]   @default([])
  imageUrl     String?    @map("image_url")
  audioUrlUs   String?    @map("audio_url_us")
  audioUrlUk   String?    @map("audio_url_uk")
  difficulty   Difficulty @default(MEDIUM)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  topic          VocabularyTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userVocabulary UserVocabulary[]
  bookmarks      Bookmark[]
  pathDayLinks   VocabularyPathDayWord[]

  @@unique([topicId, word])
  @@index([topicId])
  @@map("vocabulary_words")
}

// ---------------------------------------------------------------------------
// Vocabulary "20-day path" — a Duolingo-style sequential curriculum layered
// on top of the existing topic-based VocabularyWord data (no new word
// content; each day just curates/orders a slice of existing words).
// ---------------------------------------------------------------------------

model VocabularyPath {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  days VocabularyPathDay[]

  @@map("vocabulary_paths")
}

model VocabularyPathDay {
  id        String   @id @default(uuid()) @db.Uuid
  pathId    String   @map("path_id") @db.Uuid
  dayNumber Int      @map("day_number")
  /**
   * Groups days into a 5-day arc for display (e.g. "Khởi Đầu", "Tăng Tốc").
   */
  tierLabel String   @map("tier_label")
  createdAt DateTime @default(now()) @map("created_at")

  path     VocabularyPath                  @relation(fields: [pathId], references: [id], onDelete: Cascade)
  words    VocabularyPathDayWord[]
  progress UserVocabularyPathDayProgress[]

  @@unique([pathId, dayNumber])
  @@map("vocabulary_path_days")
}

model VocabularyPathDayWord {
  id               String @id @default(uuid()) @db.Uuid
  dayId            String @map("day_id") @db.Uuid
  vocabularyWordId String @map("vocabulary_word_id") @db.Uuid
  orderIndex       Int    @default(0) @map("order_index")

  day  VocabularyPathDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  word VocabularyWord    @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  @@unique([dayId, vocabularyWordId])
  @@map("vocabulary_path_day_words")
}

/**
 * stepsCompleted: 0-3, one per step (Học/Luyện tập/Kiểm tra). Day counts as
 * done, and the next day unlocks, once stepsCompleted reaches 3. `stars`
 * (0-3) is set from the step-3 quiz score when that step completes.
 */
model UserVocabularyPathDayProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  dayId          String    @map("day_id") @db.Uuid
  stepsCompleted Int       @default(0) @map("steps_completed")
  stars          Int       @default(0)
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  day  VocabularyPathDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([userId, dayId])
  @@map("user_vocabulary_path_day_progress")
}

model UserVocabulary {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  vocabularyWordId String    @map("vocabulary_word_id") @db.Uuid
  repetitions      Int       @default(0)
  intervalDays     Int       @default(0) @map("interval_days")
  easeFactor       Float     @default(2.5) @map("ease_factor")
  nextReviewDate   DateTime  @default(now()) @map("next_review_date") @db.Date
  lastReviewedAt   DateTime? @map("last_reviewed_at")
  isLearned        Boolean   @default(false) @map("is_learned")
  /**
   * MANUAL (user saved it themselves) vs AI_DETECTED_WEAKNESS (AI Mentor
   * auto-enrolled it after a wrong Reading/Listening answer touched this
   * word — see Question.vocabularyFocus and
   * src/lib/services/mentor/vocab-ledger.ts). Lets the UI badge
   * AI-flagged words and the export route filter to just those.
   */
  origin                VocabOrigin @default(MANUAL) @map("origin")
  sourceAttemptAnswerId String?     @map("source_attempt_answer_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord     @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  reviews        VocabularyReview[]
  sourceAttemptAnswer AttemptAnswer? @relation(fields: [sourceAttemptAnswerId], references: [id], onDelete: SetNull)

  @@unique([userId, vocabularyWordId])
  @@index([userId, nextReviewDate])
  @@index([userId, origin])
  @@map("user_vocabulary")
}

model VocabularyReview {
  id               String       @id @default(uuid()) @db.Uuid
  userVocabularyId String       @map("user_vocabulary_id") @db.Uuid
  rating           ReviewRating
  previousInterval Int          @map("previous_interval")
  newInterval      Int          @map("new_interval")
  previousEase     Float        @map("previous_ease")
  newEase          Float        @map("new_ease")
  reviewedAt       DateTime     @default(now()) @map("reviewed_at")

  userVocabulary UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)

  @@index([userVocabularyId])
  @@map("vocabulary_reviews")
}

