# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for step-by-step setup instructions.

# --- Database (self-hosted Postgres) ---------------------------------------
# Both point at the same self-hosted instance — no pooler needed at this
# scale. DIRECT_URL is used only by `prisma migrate`/Studio.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/toeic_mastery"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/toeic_mastery"

# --- Auth (custom: Google Sign-In + email/password) -------------------------
# AUTH_SECRET: long random string used to sign the session cookie (JWT,
# HS256) AND to HMAC forgot-password codes (src/lib/auth/password.ts).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
# From Google Cloud Console > APIs & Services > Credentials > OAuth Client
# ID (Web application). See README.md for the step-by-step walkthrough.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# Must exactly match one of the "Authorized redirect URIs" on that OAuth
# Client — http://localhost:3000/auth/callback for local dev.
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- EmailJS (transactional email) ------------------------------------------
# Used for two things: a Pro-purchase confirmation email (fired from
# grantProDays in src/lib/services/pro-grant.ts) and the forgot-password OTP
# email (src/app/(auth)/actions.ts). From your emailjs.com dashboard — also
# enable "Allow EmailJS API for non-browser applications" under
# Account > Security, since these are server-side calls with no browser
# Origin header for EmailJS to check against.
EMAILJS_SERVICE_ID="replace-with-emailjs-service-id"
EMAILJS_PUBLIC_KEY="replace-with-emailjs-public-key"
# Optional — lets EmailJS validate the request without relying on the
# non-browser-applications toggle above. Account > API Keys.
EMAILJS_PRIVATE_KEY=""
# Template variables: to_email, to_name, plan_name, expires_at.
EMAILJS_TEMPLATE_ID_PRO_CONFIRM="replace-with-emailjs-template-id"
# Template variables: to_email, to_name, otp_code, expires_minutes.
EMAILJS_TEMPLATE_ID_PASSWORD_RESET="replace-with-emailjs-template-id"

# --- File storage (local disk, served by Nginx) -----------------------------
# UPLOADS_DIR: absolute path on the server, OUTSIDE the app's deploy
# directory so redeploys never wipe uploaded files.
UPLOADS_DIR="/var/app-uploads"
# Public base URL Nginx serves UPLOADS_DIR from (see README.md's Nginx config).
NEXT_PUBLIC_UPLOADS_URL="http://localhost:3000/uploads"

# Public site URL — used to build absolute links where needed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Dictionary ------------------------------------------------------------
# "dictionaryapi" (default, free, no key) uses https://dictionaryapi.dev.
# Add your own provider in src/lib/services/dictionary-service.ts and set
# this to select it.
DICTIONARY_PROVIDER="dictionaryapi"

# --- Translation (English -> Vietnamese meanings) --------------------------
# "mymemory" (default, free, no key, rate-limited — fine for development).
# "google" or "deepl" for production; both require TRANSLATION_API_KEY.
TRANSLATION_PROVIDER="mymemory"
TRANSLATION_API_KEY=""

# --- VNPay (Pro upgrade checkout) -------------------------------------------
# From your VNPay merchant dashboard. Sandbox: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE="replace-with-merchant-tmn-code"
VNPAY_HASH_SECRET="replace-with-hash-secret"
# Sandbox for testing; swap to https://vnpayment.vn/paymentv2/vpcpay.html for production.
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# --- SePay (bank-transfer auto-confirmation) --------------------------------
# Alternative to VNPay for the plain personal-bank-account VietQR flow
# (declareBankTransferAction) — SePay watches a connected personal MB Bank
# account and POSTs to /api/sepay/webhook on every incoming transaction, no
# business merchant account needed. Get this from sepay.vn dashboard →
# Công ty → Webhooks (the value you set as that webhook's Authorization
# header — generate a long random string yourself, SePay just echoes
# whatever you configure back on every call).
SEPAY_WEBHOOK_API_KEY="replace-with-a-long-random-string"

# --- Cron authentication -----------------------------------------------------
# Shared secret every /api/cron/* route checks for (Authorization: Bearer
# <value>) — whatever external scheduler calls these routes (Vercel Cron per
# vercel.json, or a plain `curl`/systemd timer on a self-hosted VPS) needs
# this same value. Generate one with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# --- AI Mentor: LLM provider -------------------------------------------------
# Two supported providers (src/lib/services/mentor/llm-client.ts picks
# between them) — set only ONE key and it's auto-selected; MENTOR_LLM_PROVIDER
# only needs setting if you have both keys and want to force one.
#
#   Gemini  — free to start: no credit card, get a key at
#             https://aistudio.google.com/apikey, generous free daily/
#             per-minute quota on the Flash models. Default whenever no
#             Anthropic key is set.
#   Anthropic — the Messages API has NO free tier (unlike claude.ai's chat
#             UI, it's prepaid-credits-only) — higher quality, but not $0.
#
# MENTOR_CHAT_MODEL / MENTOR_BACKGROUND_MODEL apply to whichever provider is
# active; leave unset to use that provider's own default (see
# gemini-client.ts / anthropic-client.ts).
MENTOR_LLM_PROVIDER=""
GEMINI_API_KEY="replace-with-gemini-api-key"
ANTHROPIC_API_KEY=""
MENTOR_CHAT_MODEL=""
MENTOR_BACKGROUND_MODEL=""

# --- AI Mentor: RAG embeddings ------------------------------------------------
# Voyage AI embeddings for the vector store (content_embeddings table,
# pgvector). voyage-3 = 1024 dims — matches the column type in the mentor
# migration; changing model/dims requires a new migration + re-embedding.
# (Also prepaid/no free tier — RAG degrades gracefully to "no citations"
# without this key, so it's fine to leave unset while just trying AI Mentor
# out on Gemini's free tier.)
VOYAGE_API_KEY="replace-with-voyage-api-key"
VOYAGE_EMBEDDING_MODEL="voyage-3"
